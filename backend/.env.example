# NovelOps Backend — Environment Variables
# Copy to .env and fill in real values.

# Security
BACKEND_API_KEY=

# Feishu Bitable
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=

# Feishu Bitable Table IDs (optional overrides)
FEISHU_TABLE_ID_AGENTS=
FEISHU_TABLE_ID_AGENT_STATES=
FEISHU_TABLE_ID_AGENT_RUNS=
FEISHU_TABLE_ID_PIPELINE_RUNS=
FEISHU_TABLE_ID_STEP_RUNS=
FEISHU_TABLE_ID_HOTSPOTS=
FEISHU_TABLE_ID_HOTSPOT_ANALYSES=
FEISHU_TABLE_ID_TITLE_CANDIDATES=
FEISHU_TABLE_ID_COVER_PLANS=
FEISHU_TABLE_ID_BOOKS=
FEISHU_TABLE_ID_CHAPTER_BRIEFS=
FEISHU_TABLE_ID_CHAPTER_VERSIONS=
FEISHU_TABLE_ID_REVIEW_REPORTS=
FEISHU_TABLE_ID_REVISION_TASKS=
FEISHU_TABLE_ID_AGENT_TEAM_SNAPSHOTS=
FEISHU_TABLE_ID_APPROVAL_EVENTS=

# LLM
LLM_API_KEY=
LLM_PROVIDER=openai

# OpenCLI
# HOTSPOTS_ENABLED keeps the read API available even with collection disabled.
HOTSPOTS_ENABLED=false
OPENCLI_ENABLED=false
OPENCLI_BIN=opencli
# Install the public adapter from tools/opencli first (docs/hotspot-ingestion.md).
# No shell evaluation; API callers cannot override this command.
OPENCLI_DOUYIN_COMMAND=["novelops","douyin-hotspots","--limit","50","-f","json"]
# 1–30 seconds; respects the kernel shutdown budget.
OPENCLI_TIMEOUT=30

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]
# v0.2 runtime: enable only after configuring runtime tables and additive fields.
HARNESS_ENABLED=false
HARNESS_JOURNAL_DIR=.runtime/intents
HARNESS_POLL_INTERVAL=1
HARNESS_MAX_RETRIES=3
GENERATION_ENABLED=false
# Requires generation, hotspots, research/risk model routes and HotspotAnalyses fields.
RESEARCH_ENABLED=false
# Risk gates remain mandatory even when opportunity selection is automatic.
RESEARCH_SELECTION_REQUIRED=true
# Requires RESEARCH_ENABLED, title/cover routes and Feishu TitleCandidates/CoverPlans tables.
CREATIVE_ENABLED=false
# Artifacts required for generation; Traces for generation or hotspot collection.
FEISHU_TABLE_ID_ARTIFACTS=
FEISHU_TABLE_ID_TRACES=
MODEL_ROUTES_JSON={}
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
