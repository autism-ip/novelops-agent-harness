# NovelOps Backend — Environment Variables
# Copy to .env and fill in real values.

# Security
BACKEND_API_KEY=

# Feishu Bitable
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# LLM
LLM_API_KEY=
LLM_PROVIDER=openai

# OpenCLI
OPENCLI_ENABLED=false

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
